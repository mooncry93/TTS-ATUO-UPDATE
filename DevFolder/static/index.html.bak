<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital_TTS Studio - Midnight Neon</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Kantumruy+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- ONLY Load studio.css to ensure no clashes with the old style -->
    <link rel="stylesheet" href="studio.css">
</head>
<body>
    <div class="app-container">
        
        <!-- TOP NAVIGATION -->
        <header class="topbar">
            <div class="brand">
                <div class="logo-circle">D</div>
                <span class="brand-title">Digital_TTS</span>
            </div>
            
            <nav class="nav-links">
                <a href="#" class="nav-item active" id="nav-studio"><i class="fa-solid fa-microphone-lines"></i> Studio</a>
                <a href="#" class="nav-item" id="nav-history"><i class="fa-solid fa-clock-rotate-left"></i> History</a>
                <a href="#" class="nav-item" id="nav-settings"><i class="fa-solid fa-gear"></i> Settings</a>
            </nav>
            
            <div class="header-actions">
                <div class="lang-selector-wrapper">
                    <button id="btn-lang-selector" class="btn-lang"><i class="fa-solid fa-globe"></i> <span id="current-lang-text">en-US</span></button>
                    <div id="lang-menu-box" class="hidden"></div>
                </div>
            </div>
        </header>

        <!-- MAIN VIEWS -->
        <div class="main-views-container">
            
            <!-- ================= STUDIO VIEW ================= -->
            <div id="studio-view" class="workspace-view active">
                <div class="studio-layout">
                    
                    <!-- LEFT SIDEBAR: Configuration -->
                    <aside class="sidebar">
                        <div class="sidebar-header">
                            <h2><i class="fa-solid fa-sliders"></i> Voice Engine</h2>
                        </div>
                        
                        <div class="sidebar-content">
                            <!-- Engine Status -->
                            <div class="engine-status-box">
                                <div class="status-indicator">
                                    <span class="dot active"></span>
                                    <span id="selected-engine-label">VoxCPM2</span>
                                    <span id="selected-engine-status" class="status-text">Connected</span>
                                </div>
                                <p id="selected-engine-desc" class="engine-desc">Neural Khmer TTS</p>
                                <span id="selected-engine-port" class="hidden">8081</span>
                                <button id="btn-refresh-status" class="hidden">Refresh</button>
                            </div>

                            <!-- Language & Voice -->
                            <div class="config-group">
                                <label>Language</label>
                                <select id="select-language" class="neon-select">
                                    <option value="km-KH">km-KH (Khmer)</option>
                                    <option value="en-US">en-US (English)</option>
                                </select>
                            </div>
                            
                            <div class="config-group">
                                <label>Voice Profile</label>
                                <select id="select-voice" class="neon-select">
                                    <option value="default">Default Voice</option>
                                    <option value="sokha">Sokha (Male)</option>
                                    <option value="sreypich">Sreypich (Female)</option>
                                </select>
                                <div id="voice-design-group" class="hidden">
                                    <input type="text" id="input-new-voice-name">
                                    <input type="text" id="input-new-voice-profile">
                                    <input type="text" id="input-voice-prompt">
                                    <button id="btn-save-designed-voice"></button>
                                </div>
                                <div class="voice-actions">
                                    <button id="btn-toggle-design-voice" class="hidden">Design</button>
                                    <button id="btn-delete-voice" class="hidden">Delete</button>
                                </div>
                            </div>

                            <!-- Voice Cloning -->
                            <div class="config-group" id="drawer-cloning">
                                <label>Voice Cloning (Zero-shot)</label>
                                <select id="select-cloned-voices" class="neon-select mb-2">
                                    <option value="none">No clone reference (standard)</option>
                                    <option value="voice1">Sinn Sisamouth Clone</option>
                                    <option value="voice2">Ros Serey Sothea Clone</option>
                                </select>
                                <div id="audio-dropzone" class="dropzone">
                                    <i class="fa-solid fa-cloud-arrow-up"></i>
                                    <p>Drop reference audio</p>
                                    <input type="file" id="reference-audio-file" accept="audio/*" class="hidden">
                                </div>
                                <div id="file-loaded-info" class="hidden">
                                    <span id="loaded-file-name"></span>
                                    <button id="btn-remove-audio">X</button>
                                </div>
                                <textarea id="reference-text" class="hidden"></textarea>
                                <div id="voice-save-group" class="hidden">
                                    <button id="btn-save-cloned-voice"></button>
                                    <button id="btn-delete-cloned-voice"></button>
                                </div>
                            </div>

                            <!-- Emotion Sliders -->
                            <div class="config-group" id="drawer-emotions">
                                <label>Expressiveness: <span id="val-expressiveness">50</span></label>
                                <input type="range" id="input-expressiveness" min="0" max="100" value="50" class="neon-slider">
                                
                                <label class="mt-2">Style Strength: <span id="val-style">50</span></label>
                                <input type="range" id="input-style" min="0" max="100" value="50" class="neon-slider">
                                
                                <label class="mt-2">Fidelity: <span id="val-fidelity">75</span></label>
                                <input type="range" id="input-fidelity" min="0" max="100" value="75" class="neon-slider">
                            </div>

                            <!-- Speed & Pitch -->
                            <div class="config-group">
                                <label>Speed: <span id="val-speed">1.0x</span></label>
                                <input type="range" id="input-speed" min="0.5" max="2.0" step="0.1" value="1.0" class="neon-slider">
                                
                                <label class="mt-2">Pitch: <span id="val-pitch">+0</span></label>
                                <input type="range" id="input-pitch" min="-10" max="10" step="1" value="0" class="neon-slider">
                            </div>

                        </div>
                    </aside>

                    <!-- CENTER MAIN: Editor -->
                    <main class="editor-main">
                        <div class="editor-card">
                            <div class="editor-header">
                                <div class="emotion-tags">
                                    <button class="btn-emotion-tag" data-tag="[neutral]">[neutral]</button>
                                    <button class="btn-emotion-tag" data-tag="[happy]">[happy]</button>
                                    <button class="btn-emotion-tag" data-tag="[excited]">[excited]</button>
                                    <button class="btn-emotion-tag" data-tag="[angry]">[angry]</button>
                                    <button class="btn-emotion-tag" data-tag="[calm]">[calm]</button>
                                    <button class="btn-emotion-tag" data-tag="[rough]">[rough]</button>
                                    <button class="btn-emotion-tag" data-tag="[soft]">[soft]</button>
                                </div>
                                <div class="font-controls">
                                    <button id="btn-font-dec"><i class="fa-solid fa-minus"></i></button>
                                    <span id="font-size-display">20</span>
                                    <button id="btn-font-inc"><i class="fa-solid fa-plus"></i></button>
                                </div>
                            </div>
                            
                            <textarea id="text-input" placeholder="Type or paste your text here to synthesize..."></textarea>
                            
                            <div class="editor-footer">
                                <div class="stats">
                                    <span id="char-count">0</span> chars | <span id="word-count">0</span> words
                                </div>
                                <button id="btn-clear-text" class="btn-ghost"><i class="fa-solid fa-trash"></i> Clear</button>
                            </div>
                        </div>
                        
                        <!-- Floating Generate Button -->
                        <div class="generate-wrapper">
                            <button id="btn-generate" class="btn-generate-neon">
                                <i class="fa-solid fa-bolt"></i> Generate Speech
                            </button>
                        </div>
                    </main>

                    <!-- BOTTOM DOCK: Player & Visualizer -->
                    <footer class="bottom-dock">
                        <div class="visualizer-bg">
                            <canvas id="waveform-canvas"></canvas>
                        </div>
                        
                        <div class="dock-controls">
                            <button id="btn-play-pause" class="btn-play"><i class="fa-solid fa-play"></i></button>
                            
                            <div class="timeline">
                                <span id="current-time">0:00</span>
                                <div id="progress-bar-container" class="progress-bar">
                                    <div id="progress-bar-fill" class="progress-fill"></div>
                                </div>
                                <span id="total-time">0:00</span>
                            </div>
                            
                            <div class="volume-control">
                                <i class="fa-solid fa-volume-high"></i>
                                <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="0.8" class="neon-slider-sm">
                            </div>
                            
                            <button id="btn-download" class="btn-ghost"><i class="fa-solid fa-download"></i></button>
                        </div>
                    </footer>
                </div>
            </div>

            <!-- ================= HISTORY VIEW ================= -->
            <div id="history-view" class="workspace-view hidden">
                <div class="card history-card">
                    <div class="card-header">
                        <h2><i class="fa-solid fa-clock-rotate-left"></i> Generation History</h2>
                        <button id="btn-clear-history-all" class="btn-ghost"><i class="fa-solid fa-trash"></i> Clear All</button>
                    </div>
                    <div class="card-body">
                        <div id="history-empty" class="empty-state">
                            <i class="fa-solid fa-music"></i>
                            <p>No speech generated yet.</p>
                        </div>
                        <div id="history-list" class="history-list hidden"></div>
                    </div>
                </div>
            </div>
            
            <!-- ================= SETTINGS VIEW ================= -->
            <div id="settings-view" class="workspace-view hidden">
                <div class="card settings-card">
                    <div class="card-header">
                        <h2><i class="fa-solid fa-gear"></i> System Settings</h2>
                    </div>
                    <div class="card-body settings-grid">
                        
                        <!-- Core System -->
                        <div class="settings-box">
                            <h3><i class="fa-solid fa-microchip"></i> Core System</h3>
                            <div class="action-list">
                                <button id="btn-settings-setup" class="btn-action">Setup Dependencies</button>
                                <button id="btn-settings-download" class="btn-action">Download Models</button>
                                <button id="btn-settings-probe" class="btn-action">Probe System</button>
                                <button id="btn-settings-cleanup" class="btn-action">Cleanup Cache</button>
                            </div>
                            
                            <div class="progress-area">
                                <div id="setup-progress-indicator" class="hidden">
                                    <div class="progress-bar"><div id="setup-bar-fill"></div></div>
                                    <span id="setup-percent-txt">0%</span>
                                </div>
                                <span id="setup-status-txt" class="status-txt">Idle</span>
                            </div>
                            
                            <div class="toggle-group mt-2">
                                <label><input type="checkbox" id="low-spec-checkbox"> Low VRAM Mode</label>
                                <label><input type="checkbox" id="mock-fallback-checkbox"> Mock Fallback</label>
                            </div>
                            
                            <div class="action-list mt-2">
                                <button id="btn-purge-vram" class="btn-ghost">Purge VRAM</button>
                                <button id="btn-clear-logs" class="btn-ghost">Clear Logs</button>
                            </div>
                        </div>
                        
                        <!-- Application -->
                        <div class="settings-box">
                            <h3><i class="fa-solid fa-layer-group"></i> Application</h3>
                            <div class="config-group">
                                <label>System Language</label>
                                <select id="select-settings-lang" class="neon-select">
                                    <option value="en">English</option>
                                </select>
                            </div>
                            <div class="lists hidden">
                                <div id="settings-designed-list"></div>
                                <div id="settings-cloned-list"></div>
                            </div>
                        </div>

                        <!-- Terminal -->
                        <div class="settings-box full-width">
                            <h3><i class="fa-solid fa-terminal"></i> Terminal Output</h3>
                            <div id="terminal-output" class="terminal-box"></div>
                        </div>
                        
                    </div>
                </div>
            </div>

        </div> <!-- /main-views-container -->
    </div> <!-- /app-container -->

    <!-- ================= COMPATIBILITY LAYER ================= -->
    <!-- These IDs are required by app.js but are not part of the primary UI. 
         Keeping them hidden ensures zero JS errors. -->
    <div id="hidden-compat-layer" style="display:none;">
        <input type="range" id="input-volume">
        <span id="val-volume"></span>
        <div id="file-import-dropzone"></div>
        <input type="file" id="file-import-input">
        <div id="import-file-loaded-info"></div>
        <span id="loaded-import-file-name"></span>
        <button id="btn-remove-import"></button>
        <span id="val-lang-preview"></span>
        <span id="val-voice-preview"></span>
        <span id="val-clone-preview"></span>
        <span id="val-emotion-preview"></span>
        <span id="val-style-preview"></span>
        <span id="val-speed-preview"></span>
        <span id="val-format-preview"></span>
        <button id="btn-trigger-download"></button>
        <div id="download-progress-indicator"></div>
        <div id="download-bar-fill"></div>
        <div id="download-percent-txt"></div>
        <div id="visualizer-placeholder"></div>
        <audio id="main-audio-element"></audio>
    </div>

    <script src="app.js"></script>
</body>
</html>